// MTPNDD 架构图（feature/index）
// 生成：dot -Tpng docs/mtpndd_architecture_zh.dot -o docs/mtpndd_architecture_zh.png
digraph MTPNDD_Architecture_ZH {
  rankdir=LR;
  compound=true;
  splines=true;
  nodesep=0.35;
  ranksep=0.55;

  graph [fontname="Helvetica", fontsize=10, labelloc="t", labeljust="l"];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#444444"];
  edge  [fontname="Helvetica", fontsize=9, color="#555555"];

  subgraph cluster_app {
    label="应用 / 测试";
    color="#bdbdbd";
    style="rounded";
    app [label="C / JNI / Benchmarks\n(nqueens, conversion, …)"];
  }

  subgraph cluster_api {
    label="对外 API（idx 版本）";
    color="#6baed6";
    style="rounded";
    api [label="mtpndd.h\nmtpndd_t = uint64_t（节点 idx）\nmtpndd_bdd_t = uint64_t（Sylvan 节点号）"];
  }

  subgraph cluster_core {
    label="MTPNDD 核心（feature/index，串行）";
    color="#74c476";
    style="rounded";

    common [label="mtpndd_common.{c,h}\n- init/quit\n- config/stats/error\n- field_info + 预构建变量\n- gcProtect（根集合）"];
    nodeops [label="mtpndd_node.{c,h}\n- AND/OR/NOT/EXIST/DIFF\n- satcount\n- dot + 转换"];
    nodetable [label="mtpndd_nodetable.{c,h}\n唯一表 mk\n- hash[]：开放寻址\n- data[]：节点记录"];
    opcache [label="mtpndd_operation_cache.{c,h}\n- and/or/not 缓存\n(key: 操作数 idx)\n(val: 结果 idx)"];
    builder [label="mtpndd_edge_builder.{c,h}\n临时边集构建器\n- push\n- sort + merge\n(child 相同 => label OR 合并)"];
    edgepool [label="mtpndd_edge_array_pool.{c,h}\n连续边存储（append-only）\nedge_record = { child_idx, label_bdd }\n节点指向 slice：edge_array_idx + edge_num"];
  }

  subgraph cluster_sylvan {
    label="Sylvan / Lace";
    color="#fdae6b";
    style="rounded";
    lace   [label="Lace runtime\n（任务调度器）"];
    sylvan [label="Sylvan BDD/MTBDD\n- 节点表\n- 缓存\n- sylvan_and/or/not\n- mtbdd_satcount"];
  }

  app -> api;

  api -> common;
  api -> nodeops;
  api -> nodetable;

  common -> lace   [label="lace_start"];
  common -> sylvan [label="sylvan_init + ithvar/not"];
  common -> nodetable [label="初始化 nodetable"];
  common -> opcache [label="初始化 cache"];

  nodeops -> opcache   [label="lookup/store"];
  nodeops -> builder   [label="构建边集"];
  nodeops -> nodetable [label="mk/ref/deref"];
  nodeops -> sylvan    [label="BDD 运算"];

  builder -> sylvan    [style="dashed", label="merge：OR labels"];
  nodetable -> edgepool [label="alloc + copy"];
  nodetable -> sylvan   [style="dashed", label="边 label 的 ref/deref"];

  sylvan -> lace [style="dashed", label="并行仅发生在\nBDD 运算内部"];

  legend [shape=note, style="filled", fillcolor="#f7f7f7", color="#bdbdbd",
          label="说明：\n- 本分支 MTPNDD 自身串行\n- 节点/边统一用 idx 表示，减少指针间接访问\n- 边集通过 sort+merge 固定顺序，用于 mk 唯一化"];
  api -> legend [style="invis"];
}

