digraph MTPNDD {
    rankdir=LR;
    splines=true;
    bgcolor="white";
    node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", color="#555555", fontname="Helvetica", fontsize=11];
    edge [color="#606060", fontname="Helvetica", fontsize=10, arrowsize=0.8];

    subgraph cluster_api {
        label="API Surface";
        style="dashed";
        color="#b0b0b0";
        api [label="mtpndd.h\n• single include\n• exposes init/shutdown & ops", shape=component, fillcolor="#d7ecff"];
    }

    subgraph cluster_core {
        label="Core Library";
        style="rounded";
        color="#c0c0c0";
        common [label="mtpndd_common.c\n• runtime init/quit\n• field & config registry\n• error/status tracking", fillcolor="#ffe5cc"];
        config [label="Global State\n(g_mtpndd_config, g_mtpndd_pal_config)\n• holds per-field metadata\n• owns nodetables & caches\n• tracks GC protection", fillcolor="#fff4d9"];
        node_ops [label="mtpndd_node.c\n• node/edge structures\n• boolean & quantifier tasks\n• MTBDD conversion bridge", fillcolor="#e4f7d7"];
        nodetable [label="mtpndd_nodetable.c\n• unique-table lookup\n• refcount updates\n• triggers GC/grow", fillcolor="#e4f7d7"];
        cache [label="mtpndd_operation_cache.c\n• AND/OR/NOT caches\n• lock-striped entries\n• hash by node identity", fillcolor="#e4f7d7"];
        gc [label="GC Protect Set\n(mtpndd_gc_protect_t)\n• roots live nodes\n• RW-locked hash buckets", fillcolor="#e4f7d7"];
    }

    subgraph cluster_runtime {
        label="External Runtime";
        style="dotted";
        color="#bcbcbc";
        lace [label="Lace\n• work-stealing scheduler\n• spawns task-based ops", shape=ellipse, fillcolor="#f0f0f0"];
        sylvan [label="Sylvan MTBDD\n• BDD/MTBDD storage\n• provides satcount & refs", shape=ellipse, fillcolor="#f0f0f0"];
    }

    api -> common [label="init/quit" weight=2];
    api -> node_ops [label="boolean ops" weight=2];
    api -> config [label="stats access"];

    common -> config [label="initializes & maintains" weight=2];
    common -> lace [label="lace_start" minlen=2];
    common -> sylvan [label="sylvan_init_*" minlen=2];

    node_ops -> nodetable [label="mtpndd_mk/find" weight=2];
    node_ops -> cache [label="lookup/store"];
    node_ops -> sylvan [label="MTBDD labels" minlen=2];
    node_ops -> config [label="field layout"];

    nodetable -> config [label="updates stats"];
    nodetable -> gc [label="protect checks"];

    cache -> config [label="registered caches"];

    gc -> config [label="protect registry"];

    config -> sylvan [label="size parameters"];
    config -> cache [label="capacity" dir="both" style="dashed"];
}
