// MTPNDD architecture (feature/index)
// Generate: dot -Tpng docs/mtpndd_architecture.dot -o docs/mtpndd_architecture.png
digraph MTPNDD_Architecture {
  rankdir=LR;
  compound=true;
  splines=true;
  nodesep=0.35;
  ranksep=0.55;

  graph [fontname="Helvetica", fontsize=10, labelloc="t", labeljust="l"];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#444444"];
  edge  [fontname="Helvetica", fontsize=9, color="#555555"];

  subgraph cluster_app {
    label="Applications";
    color="#bdbdbd";
    style="rounded";
    app [label="C / JNI / Benchmarks\n(nqueens, conversion, …)"];
  }

  subgraph cluster_api {
    label="Public API (idx-based)";
    color="#6baed6";
    style="rounded";
    api [label="mtpndd.h\nmtpndd_t = uint64_t (node idx)\nmtpndd_bdd_t = uint64_t (Sylvan node id)"];
  }

  subgraph cluster_core {
    label="MTPNDD core (feature/index, serial)";
    color="#74c476";
    style="rounded";

    common [label="mtpndd_common.{c,h}\n- init/quit\n- config/stats/error\n- field_info + prebuilt vars\n- gcProtect (roots)"];
    nodeops [label="mtpndd_node.{c,h}\n- AND/OR/NOT/EXIST/DIFF\n- satcount\n- dot + conversions"];
    nodetable [label="mtpndd_nodetable.{c,h}\nUnique table (mk)\n- hash[]: open addressing\n- data[]: node records"];
    opcache [label="mtpndd_operation_cache.{c,h}\n- and/or/not caches\n(key: operand idx)\n(val: result idx)"];
    builder [label="mtpndd_edge_builder.{c,h}\nTemp edge builder\n- push\n- sort + merge\n(child duplicates => OR labels)"];
    edgepool [label="mtpndd_edge_array_pool.{c,h}\nAppend-only edge storage\nedge_record = { child_idx, label_bdd }\n(node points to slice: edge_array_idx + edge_num)"];
  }

  subgraph cluster_sylvan {
    label="Sylvan / Lace";
    color="#fdae6b";
    style="rounded";
    lace   [label="Lace runtime\n(task scheduler)"];
    sylvan [label="Sylvan BDD/MTBDD\n- node tables\n- caches\n- sylvan_and/or/not\n- mtbdd_satcount"];
  }

  // high-level wiring
  app -> api;

  api -> common;
  api -> nodeops;
  api -> nodetable;

  common -> lace   [label="lace_start"];
  common -> sylvan [label="sylvan_init + ithvar/not"];
  common -> nodetable [label="nodetable init"];
  common -> opcache [label="cache init"];

  nodeops -> opcache   [label="lookup / store"];
  nodeops -> builder   [label="build edges"];
  nodeops -> nodetable [label="mk / ref / deref"];
  nodeops -> sylvan    [label="BDD ops"];

  builder -> sylvan    [style="dashed", label="merge: OR labels"];
  nodetable -> edgepool [label="alloc + copy edges"];
  nodetable -> sylvan   [style="dashed", label="ref/deref edge labels"];

  sylvan -> lace [style="dashed", label="parallelism only inside\nBDD operations"];

  // legend
  legend [shape=note, style="filled", fillcolor="#f7f7f7", color="#bdbdbd",
          label="Notes:\n- MTPNDD itself is serial on this branch\n- Node/edge identity is stable via idx (no pointer-based nodes)\n- Edge order is canonicalized via sort+merge to support mk uniqueness"];
  api -> legend [style="invis"];
}
